<%# locals: search, selected_tags, popular_tags %>
<div class="space-y-5">
  <div>
    <span class="label">Minimum comments</span>
    <%= number_field_tag :min_comments, (search.min_comments if search.min_comments.positive?), min: 0, placeholder: "e.g. 100",
          class: "field", data: { action: "input->autosubmit#queue" } %>
    <div class="mt-2 flex gap-1.5">
      <% [ 10, 100, 500, 1000 ].each do |n| %>
        <%= link_to "#{n}+", catalog_path_with(params.to_unsafe_h, min_comments: n),
              class: "rounded-full border border-white/10 px-2.5 py-0.5 text-xs text-slate-400 hover:border-sky-400/50 hover:text-white" %>
      <% end %>
    </div>
  </div>

  <div>
    <span class="label">Published</span>
    <div class="grid grid-cols-2 gap-2">
      <%= date_field_tag :from, search.from, class: "field", "aria-label": "Published from", data: { action: "change->autosubmit#now" } %>
      <%= date_field_tag :to, search.to, class: "field", "aria-label": "Published until", data: { action: "change->autosubmit#now" } %>
    </div>
  </div>

  <div>
    <span class="label">Repack size (GB)</span>
    <div class="grid grid-cols-2 gap-2">
      <%= number_field_tag :min_size, (search.params[:min_size].presence), min: 0, step: 0.1, placeholder: "min", class: "field",
            "aria-label": "Minimum repack size in GB", data: { action: "input->autosubmit#queue" } %>
      <%= number_field_tag :max_size, (search.params[:max_size].presence), min: 0, step: 0.1, placeholder: "max", class: "field",
            "aria-label": "Maximum repack size in GB", data: { action: "input->autosubmit#queue" } %>
    </div>
  </div>

  <div data-controller="tag-search" data-tag-search-url-value="<%= tags_path %>">
    <span class="label">Genres &amp; tags <span class="normal-case tracking-normal text-slate-600">(must match all)</span></span>
    <input type="search" placeholder="Filter tags…" autocomplete="off" class="field mb-2" aria-label="Filter the tag list"
           data-tag-search-target="input" data-action="input->tag-search#search">
    <%= turbo_frame_tag "tag-list", data: { tag_search_target: "frame" } do %>
      <%= render "tags/list", selected: selected_tags, tags: popular_tags %>
    <% end %>
  </div>

  <% if search.filtered? %>
    <%= link_to "Clear all filters", games_path(sort: (search.sort unless search.sort == Game::DEFAULT_SORT)), class: "btn-ghost w-full" %>
  <% end %>
</div>
