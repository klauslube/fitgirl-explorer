<%# locals: pagy %>
<% if pagy.pages > 1 %>
  <nav class="mt-8 flex flex-wrap items-center justify-center gap-1.5 text-sm" aria-label="Pagination">
    <% cls = "min-w-9 rounded-md border border-white/10 px-3 py-1.5 text-center text-slate-300 hover:border-sky-400/50 hover:text-white" %>
    <% if pagy.prev %>
      <%= link_to "‹ Prev", pagy_url_for(pagy, pagy.prev), class: cls, rel: "prev" %>
    <% end %>
    <% pagy.series.each do |item| %>
      <% if item.is_a?(Integer) %>
        <%= link_to item, pagy_url_for(pagy, item), class: cls %>
      <% elsif item.is_a?(String) %>
        <span class="min-w-9 rounded-md bg-sky-500 px-3 py-1.5 text-center font-semibold text-ink-950" aria-current="page"><%= item %></span>
      <% else %>
        <span class="px-1 text-slate-500">…</span>
      <% end %>
    <% end %>
    <% if pagy.next %>
      <%= link_to "Next ›", pagy_url_for(pagy, pagy.next), class: cls, rel: "next" %>
    <% end %>
  </nav>
<% end %>
